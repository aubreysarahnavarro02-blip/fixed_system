# ─── Barangay Official Attendance Registry — Environment Variables ─────────────
# Copy this file to .env and fill in your values before deploying.

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,YOUR_VPS_IP

# Database (set to 'postgresql' for production, 'sqlite' for local dev)
DB_ENGINE=postgresql
DB_NAME=boar_db
DB_USER=boar_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Barangay Info
BARANGAY_NAME=Brgy. San Jose
BARANGAY_CITY=Surigao City
BARANGAY_PROVINCE=Surigao del Norte
